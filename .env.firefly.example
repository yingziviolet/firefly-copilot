# Firefly III 容器环境变量(复制为 .env.firefly 并修改)
# APP_KEY 必须是 32 位随机字符串,生成:
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
APP_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_
APP_URL=http://localhost:8080
TZ=Asia/Shanghai

DB_CONNECTION=pgsql
DB_HOST=firefly-db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=firefly
