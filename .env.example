# ==== 应用 ====
APP_ENV=dev
LOG_LEVEL=INFO

# ==== Agent 自有库(与 Firefly 的库分离)====
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot
REDIS_URL=redis://localhost:6379/0

# ==== Firefly III ====
FIREFLY_BASE_URL=http://localhost:8080
# Firefly 后台 Profile -> OAuth -> Personal Access Token
FIREFLY_PAT=
# 创建 webhook 时 Firefly 生成的 secret
FIREFLY_WEBHOOK_SECRET=

# ==== LLM(Anthropic Messages API 协议)====
# 三期切自研网关:只改 ANTHROPIC_BASE_URL(网关需兼容 Messages API 协议)
# 国内可用兼容端点示例:DeepSeek/Qwen 均提供 Anthropic 兼容 API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ==== 分类与置信度门控 ====
CONFIDENCE_THRESHOLD=0.9
DEFAULT_CURRENCY=CNY
# Firefly 中的默认资产账户名(支出从这里出)
DEFAULT_ASSET_ACCOUNT=现金钱包

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=
# 允许使用 Bot 的用户 ID(逗号分隔)
TELEGRAM_ALLOWED_USER_IDS=
# 告警/简报推送目标 chat id
TELEGRAM_ALERT_CHAT_ID=
