# ==== 应用 ====
APP_ENV=dev
LOG_LEVEL=INFO

# ==== Agent 自有库(与 Firefly 的库分离)====
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot
REDIS_URL=redis://localhost:6379/0

# ==== Firefly III ====
FIREFLY_BASE_URL=http://localhost:8080
# Firefly 后台 Profile -> OAuth -> Personal Access Token
FIREFLY_PAT=
# 创建 webhook 时 Firefly 生成的 secret
FIREFLY_WEBHOOK_SECRET=

# ==== LLM(Anthropic Messages API 协议)====
# 默认示例使用 DeepSeek V4 Flash;改用 Anthropic 官方时清空 BASE_URL 并更换 MODEL
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_EFFORT=low
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ==== 分类与置信度门控 ====
CONFIDENCE_THRESHOLD=0.9
DEFAULT_CURRENCY=CNY
# Firefly 中的默认资产账户名(支出从这里出)
DEFAULT_ASSET_ACCOUNT=现金钱包

# ==== 告警通道:企业微信群机器人 ====
# 任意群 -> 群设置 -> 群机器人 -> 添加 -> 复制 webhook 地址
WECOM_WEBHOOK_URL=

# ==== Web 控制台(复核/上传/快捷记账)====
# 访问令牌;本机使用可留空,公网部署必须设置(首次访问 /review?token=xxx 后种 cookie)
CONSOLE_TOKEN=
